# Settings for the dpp-ai service. deploy.sh copies this to /etc/dpp-ai/env on first use.
# No AWS keys go here: the service signs its calls with the EC2 instance role.

# The model: a Bedrock inference profile this AWS account can invoke, the name shown
# on the site, and its prices in USD per million tokens (the spend caps use them).
DPP_AI_MODEL_ID=global.anthropic.claude-sonnet-4-6
DPP_AI_MODEL_LABEL=Claude Sonnet 4.6
DPP_AI_PRICE_INPUT=3
DPP_AI_PRICE_OUTPUT=15
DPP_AI_PRICE_CACHE_READ=0.30
DPP_AI_PRICE_CACHE_WRITE=3.75

# Spend caps in USD. When one is reached the chat rests until the next day or month (UTC).
DPP_AI_CAP_DAY_USD=1
DPP_AI_CAP_MONTH_USD=10

# set-owner-passcode.mjs adds DPP_AI_OWNER_HASH below. Until then nobody can change data through the chat.
